{
  "manifest_version": 3,
  "name": "秋招自动填报助手 MVP",
  "version": "0.8.0",
  "description": "本地保存秋招资料，支持本地数据点选直填、规则/DeepSeek 自动识别，以及实习/获奖/家庭关系逐条新增。",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "秋招助手"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}